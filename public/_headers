# Cloudflare Pages response headers.
#
# Next's opengraph-image files export without a .png extension, so Pages
# serves them as application/octet-stream with nosniff, which some social
# platforms reject as a share image. Label them as PNGs.

/opengraph-image
  Content-Type: image/png

# Pages allows only one * per path, so the tool folder is a named placeholder.
/tools/:tool/opengraph-image-*
  Content-Type: image/png
